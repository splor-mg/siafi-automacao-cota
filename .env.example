# Credenciais de acesso ao SIAFI
SISTEMA=SIAF
USUARIO=seu_login_siafi
SENHA=sua_senha_siafi
UNIDADE_EXECUTORA=1451

# Caminho WSL até a pasta-raiz do projeto de cotas no OneDrive
# (diretório que contém as subpastas "Robo (IPU 2)", "Realizados", "Conferencia arquivo robo", etc.)
# Substitua SEU_USUARIO pelo seu nome de usuário Windows
# Exemplo: /mnt/c/Users/SEU_USUARIO/OneDrive - CAMG/General/@dcmefo/2026/Robo - Remanejamento e aprovacao de cota
ONEDRIVE_BASE=/mnt/c/Users/SEU_USUARIO/OneDrive - CAMG/General/@dcmefo/2026/Robo - Remanejamento e aprovacao de cota

# Pasta local (Linux/WSL) onde o robô trabalha durante a execução
# O robô MOVE o Excel para cá para não depender da sincronização do OneDrive enquanto
# processa, e o devolve ao OneDrive no fim (ou ao falhar). O setup.sh sugere esta:
PASTA_LOCAL=/home/SEU_USUARIO_LINUX/siafi-trabalho

# Servidor SIAFI (padrão: bhmvsb.prodemge.gov.br)
# Altere apenas se for necessário usar um ambiente diferente (ex: homologação)
SIAFI_HOST=bhmvsb.prodemge.gov.br

# Exibir a janela gráfica do x3270 durante a execução (true/false)
# Requer WSLg (Windows 11). Use false para rodar sem interface gráfica
# O bot do Telegram já força false por conta própria; isto vale para o robo.bat
SIAFI_VISIVEL=true

# --- Opcionais (os valores abaixo são os padrões) ---------------------------
# Quantas vezes tentar conectar ao SIAFI antes de desistir (VPN fora, sessão
# recusada) e quantos segundos esperar entre as tentativas.
#CONEXAO_TENTATIVAS=10
#CONEXAO_ESPERA_SEGUNDOS=3

# Quantas vezes tentar mover/remover um arquivo que o OneDrive esteja
# segurando durante a sincronização, e quantos segundos esperar entre elas.
#MOVER_TENTATIVAS=6
#MOVER_ESPERA_SEGUNDOS=2

# --- Bot do Telegram (opcional) ---------------------------------------------
# Token do bot, obtido no @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=

# ID do grupo autorizado a acionar o robo. Para descobrir: adicione o bot ao
# grupo, mande qualquer mensagem e acesse
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# O id do grupo e negativo, algo como -1001234567890.
TELEGRAM_CHAT_ID=

# Quem, dentro do grupo, pode disparar os robos com /cota e /credito. Ids
# separados por virgula. DEIXE VAZIO para que qualquer membro do grupo possa
# acionar.
# Para descobrir o seu id, mande uma mensagem no grupo e veja "from":{"id":...}
# em https://api.telegram.org/bot<TOKEN>/getUpdates
# Os demais comandos (/status, /log, /ajuda) seguem abertos ao grupo.
TELEGRAM_USUARIOS_AUTORIZADOS=

# Onde esta o repositorio do robo de credito, que o bot aciona com /credito.
# So preencha se ele nao estiver no caminho padrao abaixo.
#REPO_CREDITO=~/code/splor-mg/siafi-automacao-credito

# Por quantos dias guardar os logs de execucao em data/logs/ antes de apagar.
# A limpeza roda no inicio de cada execucao. Padrao: 30.
LOG_RETENCAO_DIAS=30

# --- Trava temporaria por UO (teste) ----------------------------------------
# UOs que o robo NAO deve enviar ao SIAFI, separadas por virgula. As linhas
# delas sao puladas e a coluna Progresso recebe o motivo abaixo.
# DEIXE VAZIO para o comportamento normal. Esvaziar desfaz a trava na proxima
# execucao — nao precisa mexer no codigo nem reiniciar nada.
UOS_BLOQUEADAS=
MOTIVO_UO_BLOQUEADA=Favor inserir as entregas junto as ações no OBZ!
